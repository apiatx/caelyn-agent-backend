modules = ["python-3.11", "nodejs-20", "postgresql-16"]
[agent]
expertMode = true

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[nix]
packages = ["psmisc"]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "fuser -k 5000/tcp"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/backend && python3.11 -m uvicorn main:app --host 0.0.0.0 --port 5000"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "fuser -k 5000/tcp 2>/dev/null; cd /home/runner/workspace/backend && python3.11 -m uvicorn main:app --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[deployment]
deploymentTarget = "autoscale"
run = ["python3.11", "-m", "uvicorn", "main:app", "--host=0.0.0.0", "--port=5000"]

[userenv]

[userenv.shared]
FMP_BLOCK_FULL_HISTORICAL = "true"
CANONICAL_HISTORY_BACKFILL_ENABLED = "true"
CANONICAL_HISTORY_FULL_BACKFILL_ENABLED = "false"
CANONICAL_HISTORY_ALLOW_MARKET_HOURS = "false"
CANONICAL_HISTORY_INCLUDE_ALL_THEME_PROXIES = "false"
CANONICAL_HISTORY_INCLUDE_ALL_THEME_CANDIDATES = "false"
CANONICAL_HISTORY_INCREMENTAL_APPEND_ENABLED = "true"
CANONICAL_HISTORY_MISSING_CATCHUP_ENABLED = "true"
